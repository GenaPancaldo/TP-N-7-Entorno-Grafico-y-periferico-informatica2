import processing.serial.*;

Serial puerto;


int e1 = 0;
int e2 = 0;
int l1 = 0;
int l2 = 0;


float xL1 = 320, yL1 = 230, radioL = 35;
float xL2 = 470, yL2 = 230;

void setup() {
  size(600, 350);
  textAlign(CENTER, CENTER);
  textSize(18);
  
  
  printArray(Serial.list());
  
  
  String nombrePuerto = Serial.list()[0]; 
  puerto = new Serial(this, nombrePuerto, 9600);
  puerto.bufferUntil('\n');
}

void draw(){
  background(255);
  stroke(0);
  strokeWeight(2);

 
  fill(130, 165, 205);
  rect(60, 80, 150, 50);
  fill(0);
  text("Entradas", 135, 105);

  if (e1 == 1) fill(100, 220, 100); 
  else fill(255);
  rect(280, 80, 80, 50);
  fill(0);
  text("E1", 320, 105);

  if (e2 == 1) fill(100, 220, 100); 
  else fill(255);
  rect(430, 80, 80, 50);
  fill(0);
  text("E2", 470, 105);

  fill(245, 225, 210);
  rect(60, 205, 150, 50);
  fill(0);
  text("Salidas", 135, 230);

  if (l1 == 1) fill(255, 220, 50); 
  else fill(255);
  ellipse(xL1, yL1, radioL * 2, radioL * 2);
  fill(0);
  text("L1", xL1, yL1);

  if (l2 == 1) fill(255, 220, 50); 
  else fill(255);
  ellipse(xL2, yL2, radioL * 2, radioL * 2);
  fill(0);
  text("L2", xL2, yL2);
}

void mousePressed() {
  if (dist(mouseX, mouseY, xL1, yL1) <= radioL) {
    puerto.write('A');
  }
  
  if (dist(mouseX, mouseY, xL2, yL2) <= radioL) {
    puerto.write('B');
  }
}

void serialEvent(Serial p) {
  String datos = p.readStringUntil('\n');
  if (datos != null) {
    datos = trim(datos);
    String[] valores = split(datos, ',');
    
    if (valores.length == 4) {
      e1 = int(valores[0]);
      e2 = int(valores[1]);
      l1 = int(valores[2]);
      l2 = int(valores[3]);
    }
  }
}
